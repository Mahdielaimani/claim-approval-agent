# Copy to .env and fill in. .env is git-ignored.

# ---- LLM providers (accessed through LiteLLM) ----
# Providers are tried in the order declared in configs/llm.yaml. A provider with no key
# is skipped. With every key empty the client runs in MOCK mode: deterministic structured
# responses, no network, no cost — which is how CI and a laptop without credentials run.
GROQ_API_KEY=
# Second Groq key. Quota headroom only, same vendor.
GROQ_API_KEY_2=
OPENAI_API_KEY=
GEMINI_API_KEY=

LLM_PRIMARY_MODEL=groq/llama-3.3-70b-versatile
LLM_FALLBACK_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=20

# ---- Langfuse (LLM observability) ----
# Optional. Without keys the tracing decorator is a no-op.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- MLflow ----
MLFLOW_TRACKING_URI=./mlflow
MLFLOW_EXPERIMENT_NAME=claim-approval-agent

# ---- Paths ----
DATA_PATH=./data/claim_use_case_dataset.xlsx
MODEL_PATH=./artifacts/models/
PROMPT_PATH=./prompts/

# ---- Runtime ----
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
