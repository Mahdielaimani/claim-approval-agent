# Copy to .env and fill in. .env is git-ignored.

# ---- LLM providers (accessed through LiteLLM) ----
# Primary. Leave empty to run the LLM client in MOCK mode: deterministic
# structured responses, no network, no cost. Keeps tests and CI runnable
# without credentials.
OPENAI_API_KEY=
# Fallback. Used automatically when the primary errors or times out.
GEMINI_API_KEY=

LLM_PRIMARY_MODEL=gpt-4o-mini
LLM_FALLBACK_MODEL=gemini/gemini-2.0-flash
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=20

# ---- Langfuse (LLM observability) ----
# Optional. Without keys the tracing decorator is a no-op.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- MLflow ----
MLFLOW_TRACKING_URI=./mlflow
MLFLOW_EXPERIMENT_NAME=claim-approval-agent

# ---- Paths ----
DATA_PATH=./data/claim_use_case_dataset.xlsx
MODEL_PATH=./artifacts/models/
PROMPT_PATH=./prompts/

# ---- Runtime ----
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
