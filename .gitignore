# ---- Model artifacts & generated outputs ----
# The serialised model is 6.8 MB and regenerable; the card and the comparison reports
# are the evidence behind the model choice, and 02_model_comparison.ipynb reads them.
artifacts/models/*
!artifacts/models/.gitkeep
!artifacts/models/model_card.json
artifacts/plots/*
!artifacts/plots/.gitkeep
artifacts/reports/*
!artifacts/reports/.gitkeep
!artifacts/reports/model_comparison.csv
!artifacts/reports/best_params.json
*.pkl
*.joblib
*.cbm
*.ubj
*.onnx

